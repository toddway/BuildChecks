  <modelVersion>4.0.0</modelVersion>
  <groupId>com.toddway</groupId>
  <artifactId>buildchecks</artifactId>
  <version>4.0.3</version>
  <name>BuildChecks</name>
  <description>A toolchain-agnostic CLI that aggregates code-analysis and test/coverage reports into one gated summary.</description>
  <url>https://github.com/toddway/BuildChecks</url>
  <licenses>
    <license>
      <name>The Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>toddway</id>
      <name>Todd Way</name>
      <url>https://github.com/toddway</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/toddway/BuildChecks.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/toddway/BuildChecks.git</developerConnection>
    <url>https://github.com/toddway/BuildChecks</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>2.2.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-serialization-json-jvm</artifactId>
      <version>1.9.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.akuleshov7</groupId>
      <artifactId>ktoml-core-jvm</artifactId>
      <version>0.7.1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.github.ajalt.clikt</groupId>
      <artifactId>clikt-jvm</artifactId>
      <version>5.0.3</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-html-jvm</artifactId>
      <version>0.12.0</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
